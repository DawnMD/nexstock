    "lucide-react": "^0.515.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.5",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"

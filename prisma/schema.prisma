// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum OrderStatus {
    NEW
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum OrderItemStatus {
    NOT_RECEIVED
    RECEIVING
    RECEIVED
    REJECTED
}

model Vendor {
    id        Int      @id @default(autoincrement())
    name      String
    reference String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    orders    Order[] // This establishes the one-to-many relationship
}

model Order {
    id                  Int           @id @default(autoincrement())
    orderNumber         String        @unique
    businessUnit        String
    purchaseOrderType   Int
    purchaseOrderDate   DateTime?
    expectedReceiptDate DateTime?
    status              OrderStatus   @default(NEW)
    notes               String?
    vendorReference     String
    buyerName           String?
    buyerCity           String?
    createdAt           DateTime      @default(now())
    createdBy           String
    updatedAt           DateTime      @updatedAt
    updatedBy           String
    paymentStatus       String?
    vendor              Vendor        @relation(fields: [vendorReference], references: [reference]) // Link to Vendor
    items               OrderItem[]
    dockBookings        DockBooking[] // Establishes the one-to-many relationship with DockBooking

    @@index([vendorReference, orderNumber, status])
}

model OrderItem {
    id               Int             @id @default(autoincrement())
    description      String
    status           OrderItemStatus @default(NOT_RECEIVED)
    orderedQuantity  Int             @default(0)
    receivedQuantity Int             @default(0)
    rejectedQuantity Int             @default(0)
    sku              String
    department       String
    qualityCheck     Boolean         @default(false)
    createdAt        DateTime        @default(now())
    updatedAt        DateTime        @updatedAt
    Order            Order?          @relation(fields: [orderId], references: [id])
    orderId          Int?

    @@index([status, sku])
}

model Dock {
    id          Int           @id @default(autoincrement())
    name        String
    status      Boolean       @default(true)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    DockBooking DockBooking[]
}

model VehicleType {
    id          Int           @id @default(autoincrement())
    type        String
    description String
    unloadTime  String
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    DockBooking DockBooking[]
}

model DockBooking {
    id            Int         @id @default(autoincrement())
    dock          Dock        @relation(fields: [dockId], references: [id])
    dockId        Int
    vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
    vehicleTypeId Int
    vehicleNumber String
    weight        Int
    queue         Int
    cbm           Int
    driverName    String
    driverPhone   String?
    eta           DateTime?
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    order         Order?      @relation(fields: [orderId], references: [id])
    orderId       Int?

    @@index([orderId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = "postgresql://shelfDB_owner:npg_3WL8UyKpGcVu@ep-sweet-night-a10ou838-pooler.ap-southeast-1.aws.neon.tech/shelfDB?sslmode=require"
}

enum OrderStatus {
    NEW
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum OrderItemStatus {
    NOT_RECEIVED
    RECEIVING
    RECEIVED
    REJECTED
}

model Vendor {
    id        Int      @id @default(autoincrement())
    name      String
    reference String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    orders    Order[] // This establishes the one-to-many relationship
}

model Order {
    id                  Int         @id @default(autoincrement())
    orderNumber         String      @unique
    businessUnit        String
    purchaseOrderType   Int
    purchaseOrderDate   DateTime?
    expectedReceiptDate DateTime?
    status              OrderStatus @default(NEW)
    notes               String?
    vendorReference     String
    buyerName           String?
    buyerCity           String?
    createdAt           DateTime    @default(now())
    createdBy           String
    updatedAt           DateTime    @updatedAt
    updatedBy           String
    paymentStatus       String?
    vendor              Vendor      @relation(fields: [vendorReference], references: [reference]) // Link to Vendor
    items               OrderItem[]

    @@index([vendorReference, orderNumber, status])
}

model OrderItem {
    id               Int             @id @default(autoincrement())
    description      String
    status           OrderItemStatus @default(NOT_RECEIVED)
    totalQuantity    Int             @default(0)
    receivedQuantity Int             @default(0)
    rejectedQuantity Int             @default(0)
    sku              String
    department       String
    qualityCheck     Boolean         @default(false)
    createdAt        DateTime        @default(now())
    updatedAt        DateTime        @updatedAt
    Order            Order?          @relation(fields: [orderId], references: [id])
    orderId          Int?

    @@index([status, sku])
}

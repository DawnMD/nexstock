// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum OrderStatus {
    NEW
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum OrderType {
    STANDARD
    IMPORT
    RETURN
}

enum OrderItemStatus {
    NOT_RECEIVED
    RECEIVING
    RECEIVED
    REJECTED
}

enum ActivityType {
    CHECK_IN
    OPEN
    CLOSE
    CHECK_OUT
}

enum PaymentStatus {
    PENDING
    PAID
    NOT_PAID
}

enum QualityCheckStatus {
    PASSED
    FAILED
}

enum AdjustmentType {
    ADDITION
    SUBTRACTION
}

/// Why stock moved. Every InventoryMovement carries one, so the ledger explains
/// itself without joining back to the originating record.
enum MovementReason {
    RECEIPT
    QC_REJECT
    ADJUSTMENT_ADD
    ADJUSTMENT_SUB
    PUTAWAY_OUT
    PUTAWAY_IN
    TRANSFER
}

/// Which table `InventoryMovement.refId` points at. The referenced ids are a mix
/// of Int and cuid, so `refId` is a string and this enum says how to read it.
enum MovementRefType {
    RECEIVE_ITEM
    PUTAWAY
    ADJUSTMENT
    QUALITY_CHECK
}

/// Better Auth core tables. The shape is dictated by `better-auth` — cross-checked
/// against `npx auth@latest generate` — so treat the columns as fixed and add app
/// concerns via relations rather than by editing these fields.
model User {
    id            String   @id
    name          String
    email         String   @unique
    emailVerified Boolean  @default(false)
    image         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    sessions Session[]
    accounts Account[]

    // Audit back-relations. Every `createdBy`/`updatedBy`/… column in the warehouse
    // schema is a real foreign key onto this table, so a user with history cannot
    // be deleted (the required sides are `onDelete: Restrict`).
    ordersCreated         Order[]             @relation("OrderCreatedBy")
    ordersUpdated         Order[]             @relation("OrderUpdatedBy")
    dockActivitiesCreated DockActivity[]      @relation("DockActivityCreatedBy")
    dockActivitiesUpdated DockActivity[]      @relation("DockActivityUpdatedBy")
    skusCreated           Sku[]               @relation("SkuCreatedBy")
    skusUpdated           Sku[]               @relation("SkuUpdatedBy")
    locationsCreated      Location[]          @relation("LocationCreatedBy")
    locationsUpdated      Location[]          @relation("LocationUpdatedBy")
    qualityChecks         QualityCheck[]      @relation("QualityCheckInspectedBy")
    receiveItems          ReceiveItem[]       @relation("ReceiveItemReceivedBy")
    adjustments           Adjustment[]        @relation("AdjustmentAdjustedBy")
    putaways              Putaway[]           @relation("PutawayPutawayBy")
    inventoryMovements    InventoryMovement[] @relation("InventoryMovementCreatedBy")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String   @unique
    ipAddress String?
    userAgent String?
    userId    String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([providerId, accountId])
    @@index([userId])
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

model Vendor {
    id        Int      @id @default(autoincrement())
    name      String
    reference String   @unique //Reference is the unique identifier for the vendor
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    orders    Order[] // This establishes the one-to-many relationship

    @@index([reference])
}

model Order {
    id                  Int           @id @default(autoincrement())
    orderNumber         String        @unique //Order number is the unique identifier for the order
    businessUnit        String
    orderType           OrderType     @default(STANDARD)
    purchaseOrderDate   DateTime?
    expectedReceiptDate DateTime?
    status              OrderStatus   @default(NEW)
    notes               String?
    vendorReference     String
    buyerName           String?
    buyerCity           String?
    createdAt           DateTime      @default(now())
    createdBy           String
    createdByUser       User          @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    updatedAt           DateTime      @updatedAt
    updatedBy           String
    updatedByUser       User          @relation("OrderUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
    paymentStatus       PaymentStatus @default(NOT_PAID)
    vendor              Vendor        @relation(fields: [vendorReference], references: [reference]) // Link to Vendor
    items               OrderItem[]
    dockBookings        DockBooking[] // Establishes the one-to-many relationship with DockBooking
    adjustments         Adjustment[] // Establishes the one-to-many relationship with Adjustment

    @@index([vendorReference, orderNumber, status])
    @@index([createdBy])
    @@index([updatedBy])
}

model OrderItem {
    id                   Int             @id @default(autoincrement())
    description          String
    status               OrderItemStatus @default(NOT_RECEIVED)
    orderedQuantity      Int             @default(0)
    receivedQuantity     Int             @default(0)
    rejectedQuantity     Int             @default(0)
    department           String
    qualityCheckRequired Boolean         @default(false)
    createdAt            DateTime        @default(now())
    updatedAt            DateTime        @updatedAt
    Order                Order?          @relation(fields: [orderId], references: [orderNumber]) // Link to Order by orderNumber for eg ORD-123456 not 1,2,4,5,6
    orderId              String
    Sku                  Sku             @relation(fields: [skuId], references: [sku]) // Link to Sku by skuId for eg SKU-123456 not 1,2,4,5,6
    skuId                String
    qualityCheck         QualityCheck?
    receiveItems         ReceiveItem[] // Updated to one-to-many
    adjustments          Adjustment[]

    @@index([status, skuId, id])
}

model Dock {
    id          Int           @id @default(autoincrement())
    name        String
    status      Boolean       @default(true)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    dockBooking DockBooking[]

    @@index([name])
}

model VehicleType {
    id          Int           @id @default(autoincrement())
    type        String
    description String
    unloadTime  String
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    dockBooking DockBooking[]

    @@index([type])
}

model DockBooking {
    id            Int            @id @default(autoincrement())
    dock          Dock           @relation(fields: [dockId], references: [id])
    dockId        Int
    vehicleType   VehicleType    @relation(fields: [vehicleTypeId], references: [id])
    vehicleTypeId Int
    vehicleNumber String
    weight        Int
    queue         Int
    cbm           Int
    driverName    String
    driverPhone   String?
    eta           DateTime?
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    order         Order          @relation(fields: [orderId], references: [orderNumber])
    orderId       String
    activities    DockActivity[]

    @@index([orderId])
}

model DockActivity {
    id                 Int          @id @default(autoincrement())
    activityType       ActivityType
    createdAt          DateTime     @default(now())
    updatedAt          DateTime     @updatedAt
    createdBy          String
    createdByUser      User         @relation("DockActivityCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    updatedBy          String?
    updatedByUser      User?        @relation("DockActivityUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
    containerCondition Boolean      @default(false) //Good or Bad
    notes              String?
    dockBooking        DockBooking  @relation(fields: [dockBookingId], references: [id], onDelete: Cascade)
    dockBookingId      Int

    @@index([dockBookingId])
    @@index([createdBy])
    @@index([updatedBy])
}

model Sku {
    id            Int         @id @default(autoincrement())
    sku           String      @unique
    description   String
    //Physical attributes
    weight        Float?
    length        Float?
    width         Float?
    height        Float?
    cbm           Float?
    //Inventory attributes
    uom           String?
    //Quality check
    qualityCheck  Boolean     @default(false)
    hasShelfLife  Boolean     @default(false)
    shelfLifeDays Int?
    storageType   String?
    storageZone   String?
    // Classification
    department    String
    // Tracking
    isActive      Boolean     @default(true)
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    createdBy     String
    createdByUser User        @relation("SkuCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    updatedBy     String
    updatedByUser User        @relation("SkuUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
    //Lot attributes
    lot           String?
    lotExpiryDate DateTime?
    OrderItem     OrderItem[]

    inventoryMovements InventoryMovement[]
    inventoryBalances  InventoryBalance[]

    @@index([sku])
    @@index([createdBy])
    @@index([updatedBy])
}

model QualityCheck {
    id                  Int       @id @default(autoincrement())
    orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
    orderItemId         Int       @unique
    qualityCheckStatus  Boolean   @default(false)
    inspectedBy         String
    inspectedByUser     User      @relation("QualityCheckInspectedBy", fields: [inspectedBy], references: [id], onDelete: Restrict)
    inspectedAt         DateTime  @default(now())
    remarks             String?
    inspectedQuantity   Int       @default(0)
    descrepencyQuantity Int       @default(0)
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    @@index([qualityCheckStatus, orderItemId])
    @@index([inspectedBy])
}

model ReceiveItem {
    id               Int       @id @default(autoincrement())
    orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
    orderItemId      Int // Removed @unique constraint
    receivedQuantity Int       @default(0)
    receivedBy       String
    receivedByUser   User      @relation("ReceiveItemReceivedBy", fields: [receivedBy], references: [id], onDelete: Restrict)
    receivedAt       DateTime
    sku              String
    receivedNotes    String?
    // An LPN is a physical pallet label, so it identifies exactly one receipt
    // across the whole warehouse. Putaway looks receipts up by LPN alone.
    location         String
    locationRef      Location  @relation("ReceiveItemLocation", fields: [location], references: [location], onDelete: Restrict)
    lpn              String    @unique
    lot              String?
    manufacturedDate DateTime?
    uom              String
    lotExpiryDate    DateTime?
    vehicleNumber    String
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    putaways         Putaway[] // Track putaway operations for this LPN

    @@index([orderItemId, lpn, sku])
    @@index([receivedBy])
}

model Adjustment {
    id               String         @id @unique @default(cuid())
    orderItemId      Int
    reason           String?
    adjustmentType   AdjustmentType
    orderId          String
    adjustedQuantity Int
    adjustedBy       String
    adjustedByUser   User           @relation("AdjustmentAdjustedBy", fields: [adjustedBy], references: [id], onDelete: Restrict)
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
    order            Order          @relation(fields: [orderId], references: [orderNumber], onDelete: Restrict)

    @@index([orderItemId, orderId, id])
    @@index([adjustedBy])
}

model Location {
    id             Int      @id @default(autoincrement())
    location       String   @unique
    status         Boolean  @default(true)
    length         Int
    width          Int
    height         Int
    cbm            Int?
    weightCapacity Int?
    zone           String
    aisle          String
    description    String?
    createdBy      String
    createdByUser  User     @relation("LocationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    updatedBy      String?
    updatedByUser  User?    @relation("LocationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    putawaysIn   Putaway[]     @relation("PutawayToLocation") // Track putaways into this location
    putawaysOut  Putaway[]     @relation("PutawayFromLocation") // Track putaways out of this location
    receiveItems ReceiveItem[] @relation("ReceiveItemLocation") // Stock received into this location

    inventoryMovements InventoryMovement[] @relation("InventoryMovementLocation")
    inventoryBalances  InventoryBalance[]  @relation("InventoryBalanceLocation")

    @@index([location])
    @@index([createdBy])
    @@index([updatedBy])
}

model Putaway {
    id              Int          @id @default(autoincrement())
    lpn             String
    sku             String
    quantity        Int
    fromLocation    String
    toLocation      String
    putawayBy       String
    putawayByUser   User         @relation("PutawayPutawayBy", fields: [putawayBy], references: [id], onDelete: Restrict)
    putawayAt       DateTime     @default(now())
    notes           String?
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt
    location        Location     @relation("PutawayToLocation", fields: [toLocation], references: [location], onDelete: Restrict)
    fromLocationRef Location     @relation("PutawayFromLocation", fields: [fromLocation], references: [location], onDelete: Restrict)
    ReceiveItem     ReceiveItem? @relation(fields: [receiveItemId], references: [id], onDelete: SetNull)
    receiveItemId   Int?

    @@index([lpn, sku, fromLocation, toLocation])
    @@index([putawayBy])
}

/// Append-only stock ledger: one row per movement of stock, signed so that
/// summing them for a key reproduces the on-hand balance exactly.
///
/// Rows are never updated or deleted. `InventoryBalance` is the materialised
/// running total, written in the same transaction, and the two are expected to
/// agree — that equality is the invariant the whole inventory core rests on.
model InventoryMovement {
    id Int @id @default(autoincrement())

    sku    String
    skuRef Sku    @relation(fields: [sku], references: [sku], onDelete: Restrict)

    /// The pallet label the stock moved on. Every unit enters the warehouse on
    /// a receipt, and a receipt always carries an LPN, so this is never blank.
    lpn String

    /// Empty string rather than NULL for un-lotted stock: this column is part of
    /// `InventoryBalance`'s unique key, and Postgres treats NULLs as distinct,
    /// which would let a fresh balance row be created on every movement.
    lot String @default("")

    location    String
    locationRef Location @relation("InventoryMovementLocation", fields: [location], references: [location], onDelete: Restrict)

    /// Signed: positive puts stock in, negative takes it out. A putaway is a
    /// pair of rows (negative out, positive in) that nets to zero.
    quantity Int

    reason MovementReason

    /// Back-pointer to the record that caused the movement, so any balance can
    /// be traced to the receipt, putaway, adjustment, or QC that produced it.
    refType MovementRefType
    refId   String

    notes         String?
    createdBy     String
    createdByUser User     @relation("InventoryMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    createdAt     DateTime @default(now())

    @@index([sku, location, lot, lpn])
    @@index([refType, refId])
    @@index([createdAt])
    @@index([createdBy])
}

/// Materialised stock on hand for one (sku, location, lot, lpn) key.
///
/// Maintained with atomic `increment`/`decrement` in the same transaction as the
/// `InventoryMovement` insert, so it can never drift from the ledger. Rows are
/// left in place at quantity 0 rather than deleted, which keeps the upsert cheap
/// and preserves the fact that stock was once there.
model InventoryBalance {
    id Int @id @default(autoincrement())

    sku    String
    skuRef Sku    @relation(fields: [sku], references: [sku], onDelete: Restrict)

    location    String
    locationRef Location @relation("InventoryBalanceLocation", fields: [location], references: [location], onDelete: Restrict)

    /// See the note on `InventoryMovement.lot` — "" means un-lotted.
    lot String @default("")
    lpn String

    quantity  Int      @default(0)
    updatedAt DateTime @updatedAt

    @@unique([sku, location, lot, lpn])
    @@index([sku])
    @@index([location])
    @@index([lpn])
}

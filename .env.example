# Neon pooled connection (note the `-pooler` host) — used by Prisma Client.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection — used by the Prisma CLI for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
# 32+ character random string signing session cookies. Generate with `npx auth@latest secret`.
BETTER_AUTH_SECRET="replace-with-32-plus-character-random-string"
# Resend API key — sign-up is gated on a verification email, so this must be real.
# Create one at https://resend.com/api-keys.
RESEND_API_KEY="re_replace_with_a_real_key"
# `From` header on outbound mail. The domain must be verified in Resend; the
# default below only delivers to the address that owns the Resend account.
EMAIL_FROM="NexStock <onboarding@resend.dev>"
# Neon pooled connection (note the `-pooler` host) — used by Prisma Client.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection — used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
# 32+ character random string signing session cookies. Generate with `npx auth@latest secret`.
BETTER_AUTH_SECRET="replace-with-32-plus-character-random-string"
# Public origin of this deployment.
BETTER_AUTH_URL="http://localhost:3000"